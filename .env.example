# diagent environment template
# Copy to .env and fill in values. Never commit .env to version control.

# Local & Proxy LLM Endpoints
LOCALAPI_BASE_URL=http://127.0.0.1:8317/v1
LOCALAPI_API_KEY=

# Direct Provider Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Aggregators & Proxy Services (e.g. Byesu)
BYESU_API_KEY=
BYESU_GEMINI_API_KEY=
BYESU_KIMI_API_KEY=

# MCP Integrations
TICKTICK_TOKEN=
TIMEZONE=Europe/Moscow
LINEAR_API_KEY=

# System / Paths
DSH_HOME=
PYTHON_EXE=python
